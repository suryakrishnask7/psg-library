# PSG Library Environment Variables
PORT=5000

# For local development with local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/psg_library

# For cloud deployment with MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/psg_library?retryWrites=true&w=majority&appName=PSG

